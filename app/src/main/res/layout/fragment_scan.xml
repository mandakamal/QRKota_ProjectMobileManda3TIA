<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ice_blue"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan QR Code"
            android:textColor="@color/navy"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Arahkan kamera ke QR Code fasilitas untuk membuka informasinya."
            android:textColor="@color/gray"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:contentDescription="Ilustrasi QR Code"
                android:padding="14dp"
                android:src="@drawable/ic_scan" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Pastikan QR Code terlihat jelas dan pencahayaan cukup."
            android:textColor="@color/gray"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStartScan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/baby_blue"
            android:text="Mulai Scan dengan Kamera"
            android:textAllCaps="false"
            android:textColor="@color/navy"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDemoScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/soft_pink"
            android:text="Coba Simulasi Scan"
            android:textAllCaps="false"
            android:textColor="@color/navy" />
    </LinearLayout>
</ScrollView>
