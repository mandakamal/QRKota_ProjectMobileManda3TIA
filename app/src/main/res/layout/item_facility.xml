<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
        <ImageView android:id="@+id/imgFacility" android:layout_width="86dp" android:layout_height="78dp" android:contentDescription="Foto fasilitas" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/tvFacilityName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/navy" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvFacilityCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/pink_strong" android:textSize="12sp" />
            <TextView android:id="@+id/tvFacilityDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/navy" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Buka detail" android:src="@drawable/ic_back" android:rotation="180" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
