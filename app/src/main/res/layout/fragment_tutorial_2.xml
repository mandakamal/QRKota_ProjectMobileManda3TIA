<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tutorial_pink">
    <ImageView android:id="@+id/imgLogo" android:layout_width="160dp"
        android:layout_height="160dp" android:src="@drawable/logo_qrkota"
        android:contentDescription="Logo QRKota Pekanbaru"
        app:layout_constraintBottom_toTopOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/tvTitle" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginHorizontal="28dp"
        android:gravity="center" android:text="Cari dan Pilih Fasilitas" android:textSize="23sp"
        android:textStyle="bold" android:textColor="@color/navy"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/tvDesc" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginHorizontal="32dp"
        android:layout_marginTop="18dp" android:gravity="center"
        android:text="Gunakan pencarian serta pilihan kategori untuk menemukan fasilitas yang kamu butuhkan." android:textColor="@color/navy" android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
