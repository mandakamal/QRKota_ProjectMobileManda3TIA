<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ice_blue" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selamat Datang" android:textColor="@color/navy" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Scan, Jelajahi, Kenali Kotamu." android:textColor="@color/gray" android:textSize="13sp" />
            </LinearLayout>
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="Profil" android:src="@drawable/ic_profile" android:padding="7dp" android:background="@drawable/bg_card" />
        </LinearLayout>
        <EditText android:id="@+id/etHomeSearch" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp" android:hint="Cari fasilitas atau lokasi" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/navy" android:textColorHint="@color/gray" android:inputType="text" android:imeOptions="actionSearch" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Fitur Utama" android:textColor="@color/navy" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardScan" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/ice_blue" app:strokeColor="@color/baby_blue" app:strokeWidth="1dp" app:cardCornerRadius="14dp" xmlns:app="http://schemas.android.com/apk/res-auto"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_scan" android:contentDescription="Scan QR"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Scan QR Code" android:textColor="@color/navy" android:textSize="12sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSearch" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginStart="6dp" app:cardBackgroundColor="@color/blush_white" app:strokeColor="@color/soft_pink" app:strokeWidth="1dp" app:cardCornerRadius="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_location" android:contentDescription="Cari lokasi"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Lihat Lokasi" android:textColor="@color/navy" android:textSize="12sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardHistory" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/blush_white" app:strokeColor="@color/soft_pink" app:strokeWidth="1dp" app:cardCornerRadius="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_history" android:contentDescription="Riwayat scan"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Riwayat Scan" android:textColor="@color/navy" android:textSize="12sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardFavorites" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginStart="6dp" app:cardBackgroundColor="@color/ice_blue" app:strokeColor="@color/baby_blue" app:strokeWidth="1dp" app:cardCornerRadius="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_favorite" android:contentDescription="Favorit"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Favorit" android:textColor="@color/navy" android:textSize="12sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Fasilitas Populer" android:textColor="@color/navy" android:textSize="18sp" android:textStyle="bold" />
        <ListView android:id="@+id/listPopular" android:layout_width="match_parent" android:layout_height="270dp" android:layout_marginTop="8dp" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
