<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ice_blue">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detailToolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/baby_blue"
        app:title="Detail Fasilitas" app:titleTextColor="@color/navy"
        app:navigationIcon="@drawable/ic_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <ImageView android:id="@+id/imgDetail" android:layout_width="match_parent" android:layout_height="190dp" android:scaleType="centerCrop" android:contentDescription="Foto fasilitas" />
            <TextView android:id="@+id/tvDetailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/navy" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvDetailCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/pink_strong" android:textSize="13sp" />
            <TextView android:id="@+id/tvDetailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/navy" android:textSize="14sp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="14dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alamat" android:textColor="@color/navy" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:textColor="@color/gray" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Jam Operasional" android:textColor="@color/navy" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailHours" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:textColor="@color/gray" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fasilitas" android:textColor="@color/navy" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailFacilities" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/gray" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                <Button android:id="@+id/btnDetailMap" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Lihat Lokasi" android:textAllCaps="false" android:backgroundTint="@color/baby_blue" android:textColor="@color/navy" />
                <Button android:id="@+id/btnDetailFavorite" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Simpan" android:textAllCaps="false" android:backgroundTint="@color/soft_pink" android:textColor="@color/navy" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
