<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/ice_blue">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cari Fasilitas" android:textColor="@color/navy" android:textSize="22sp" android:textStyle="bold" />
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp" android:hint="Cari nama, kategori, atau lokasi" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/navy" android:textColorHint="@color/gray" android:inputType="text" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="38dp" android:text="Semua" android:textAllCaps="false" android:textSize="12sp" android:backgroundTint="@color/pink_strong" android:textColor="@color/white" />
        <Button android:id="@+id/filterPark" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="6dp" android:text="Taman" android:textAllCaps="false" android:textSize="12sp" android:backgroundTint="@color/baby_blue" android:textColor="@color/navy" />
        <Button android:id="@+id/filterEducation" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="6dp" android:text="Pendidikan" android:textAllCaps="false" android:textSize="12sp" android:backgroundTint="@color/baby_blue" android:textColor="@color/navy" />
        <Button android:id="@+id/filterMuseum" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="6dp" android:text="Museum" android:textAllCaps="false" android:textSize="12sp" android:backgroundTint="@color/baby_blue" android:textColor="@color/navy" />
    </LinearLayout></HorizontalScrollView>
    <ListView android:id="@+id/listSearch" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:divider="@color/line" android:dividerHeight="1dp" />
</LinearLayout>
